# ---- 模型（可继承仓库根目录 D:/shixi/.env） ----
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- MySQL（必填：把 <你的密码> 换成本机 MySQL root 密码） ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=<你的密码>
MYSQL_DB=ramp

# ---- 可调产品参数（留空用默认值） ----
# RAMP_CONFIDENCE_THRESHOLD=0.62
# RAMP_HYBRID_ALPHA=0.5
# RAMP_WEEKLY_PUSH_BUDGET=2
# RAMP_EMBEDDING_BACKEND=hashing      # 或 sentence-transformers
# RAMP_PRICING_CONFIRMED=true         # 核对过官网定价后设为 true

# LangSmith 可观测（可选，留空则不启用）https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ramp-onboarding-agent

# 业务查询：builtin 查询已确认快照；off 不接入；live 尚未实现
RAMP_EXTERNAL_MODE=builtin

# 可选：企业网关入站推送。仅HTTPS；配置后指定字段归接口管理，禁用人工覆盖。
# 明文令牌仅保存在企业网关；此处填其SHA256摘要，不填明文。
RAMP_DATA_INGEST_TOKEN_SHA256=
RAMP_DATA_INGEST_FIELDS=probation,leave_balance,social_insurance,housing_fund,onboarding_docs
